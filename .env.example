# Server / Dashboard Configuration
NAS_NAME=NAS
PORT=8082
WEBDAV_PORT=8084
# HOST_IP=192.168.1.100       # Override automatic IP detection for the dashboard header

# Data & Persistence
# DATA_DIR=/app/data          # Directory for persistent application data
# LAYOUT_PATH=/app/data/dash_layout.json # Specific path for the dashboard layout config

# Storage & Pool Mounts
STORAGE_POOL_PATH=/mnt/user   # Host storage pool directory (/mnt/user on Unraid, /mnt/storage on Linux)
POOL_PATH=/mnt/user
OS_NVME=nvme1n1
# DISKS=sda,sdb,sdc,nvme0n1 # Leave commented out for automatic discovery
# SHOW_OS_DISK=1              # Set to 0 to hide the OS NVMe from the LCD

# Optional Hardware / Performance Tuning
# ENABLE_FB=1                 # Set to 0 to disable LCD framebuffer rendering
# LCD_FPS=10
# LCD_FORMAT=png              # Options: png (default, speed-optimized) or jpeg (ultra-fast turbo)
# LED_PORT=/dev/ttyACM0

# SMART Polling Intervals (seconds)
# SMART_POLL_HDD=45
# SMART_POLL_NVME=15

# Authentication
# WEB_PASSWORD=admin        # Password to protect the web dashboard (default is admin)
# ZETTNAS_DATA_KEY=         # Optional: encrypts the AI index and chat history at rest (16+ chars, keep a copy)

# UPS & Power Management (Direct USB HID, NUT, or APCUPSD Protocol)
# UPS_MODE=auto             # Options: auto (probes USB HID, NUT, apcupsd, power_supply), usb, nut, apcupsd
# NUT_HOST=127.0.0.1        # Network UPS Tools (NUT) daemon IP / hostname
# NUT_PORT=3493             # NUT server port (default 3493)
# NUT_NAME=ups              # Monitored UPS battery name

# Multi-Channel Notifications (Apprise)
# APPRISE_URLS=             # Space- or comma-separated Apprise URLs (e.g. discord://..., mailgun://...)

# Advanced Container & Hardware Controls
# DOCKER_SOCK=/var/run/docker.sock # Path to host Docker Engine socket
# ZERO_RPM_NVME_CEILING=50        # Temperature (°C) above which Zero RPM fan mode is revoked
# FAN_ZERO_RPM_STOP_DELAY=30      # Seconds to wait after drive spindown before stopping fans (default 30s)
# BACKUP_DIR=/app/data/backups    # Directory for configuration backup archives

# Virtual Machines & Hypervisor
# VM_ISO_DIR=/mnt/user/isos       # Directory for uploaded and downloaded guest ISO images
# KVM_DEVICE=/dev/kvm             # Hardware virtualization device path

# Network, Mesh & Inbound SFTP
# SFTP_PORT=2222                  # Drop-in chrooted SFTP server port
# TAILSCALE_STATE_DIR=/app/data/tailscale # State directory for embedded Tailscale mesh node

# Release Channel & In-App Updates
# UPDATE_CHANNEL=stable           # Options: stable (official tagged releases) or edge (latest main branch commits)

# Platform Abstraction Layer (PAL) & Observer Mode
# ZETTNAS_OBSERVER_ADAPTER=auto   # Options: auto, generic, fygoos, zettos, ugos, truenas, proxmox, unraid
