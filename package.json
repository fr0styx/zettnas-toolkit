{
  "name": "zettnas-toolkit",
  "version": "1.10.3",
  "description": "Universal hardware orchestration suite, glassmorphic Web Desktop OS, and container management platform for any NAS and homelab server.",
  "main": "index.js",
  "scripts": {
    "test": "node ./node_modules/vitest/dist/cli.js run",
    "test:coverage": "node ./node_modules/vitest/dist/cli.js run --coverage",
    "build": "node -e \"require('fs').rmSync('static/assets',{recursive:true,force:true})\" && node ./node_modules/vite/bin/vite.js build && node frontend/scripts/compress-assets.mjs static",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "budget": "node frontend/scripts/check-budget.mjs static",
    "lint:i18n": "node frontend/scripts/i18n-lint.mjs",
    "lint:css": "node frontend/scripts/css-budget.mjs",
    "lint:js": "eslint frontend vite.config.mjs vitest.config.mjs eslint.config.mjs --max-warnings 71",
    "lint:py": "ruff check app.py backend tests",
    "format:py": "ruff format app.py backend tests",
    "lint": "ruff check app.py backend tests scripts && ruff format --check app.py backend tests scripts",
    "check:all": "npm run lint && npm test",
    "icons": "node frontend/scripts/build-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0styx/zettnas-toolkit.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fr0styx/zettnas-toolkit/issues"
  },
  "homepage": "https://github.com/fr0styx/zettnas-toolkit#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "lucide-static": "1.61.0",
    "parse5": "^8.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.6.1",
    "dompurify": "3.4.17",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
