# Allow-list: the image build only sees what is listed here (OPS-12).
# Anything else in the working tree (data/, .git, secrets, node_modules,
# local build output, scratch files) never reaches the build context.
*

!app.py
!pyproject.toml
!requirements.txt
!requirements.lock
!requirements-dev.txt
!package.json
!package-lock.json
!vite.config.mjs
!backend/
!frontend/
!static/img/
!static/manifest.json

# Never, even inside allowed folders
**/__pycache__/
**/*.py[cod]
**/.fuse_hidden*
**/.DS_Store
frontend/src/__tests__/
