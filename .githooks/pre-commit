#!/bin/sh
# Checks the STAGED version of each Python file with Ruff (OPS-15).
# It never rewrites or re-stages anything, so unstaged edits stay out of the
# commit. Fix with `ruff format <file>` / `ruff check --fix <file>`, stage, retry.
# Enable once per clone:  git config core.hooksPath .githooks
set -u

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$files" ] && exit 0

ruff_cmd() {
  if command -v ruff >/dev/null 2>&1; then
    ruff "$@"
  elif command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx zettnas-toolkit; then
    docker exec -i zettnas-toolkit ruff "$@"
  else
    return 127
  fi
}

if ! ruff_cmd --version >/dev/null 2>&1; then
  echo "[pre-commit] ruff is not available; skipping Python checks."
  exit 0
fi

# Copy the staged versions into a scratch folder inside the repo, so any ruff
# (including wrappers that run it in a container) sees the repo's config.
root=$(git rev-parse --show-toplevel)
tmp="$root/.git/ruff-staged"
rm -rf "$tmp" && mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT
for f in $files; do
  mkdir -p "$tmp/$(dirname "$f")"
  git show ":$f" > "$tmp/$f"
done

fail=0
for f in $files; do
  if ! ruff_cmd format --check --quiet "$tmp/$f" >/dev/null 2>&1; then
    echo "[pre-commit] not formatted: $f  (run: ruff format $f)"
    fail=1
  fi
  if ! ruff_cmd check --quiet "$tmp/$f" >/dev/null 2>&1; then
    echo "[pre-commit] lint errors in $f  (run: ruff check $f)"
    fail=1
  fi
done

[ "$fail" -eq 0 ] && echo "[pre-commit] staged Python files are clean."
exit "$fail"
